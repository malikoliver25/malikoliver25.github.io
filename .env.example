# EmailJS credentials (client-safe public key + service/template IDs)
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# Terminal agent API endpoint (full URL incl. /chat path)
VITE_TERMINAL_API_URL=https://your-terminal-api.example.com/chat
